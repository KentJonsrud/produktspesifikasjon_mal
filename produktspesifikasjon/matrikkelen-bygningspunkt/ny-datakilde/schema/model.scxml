         <sc:sequenceNumber>9</sc:sequenceNumber>
         <sc:typeId>C11</sc:typeId>
         <sc:typeName>OpprinnelsesKode</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>sefrakIdent</sc:name>
         <sc:id>C2_10</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>&lt;font color="#333333"&gt;sefrakminnets objektnummer, bestående av henvisning til (evt utgått) kommune, registreringskretsnummer og husløpenummer &lt;/font&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..*</sc:cardinality>
         <sc:sequenceNumber>10</sc:sequenceNumber>
         <sc:typeId>C6</sc:typeId>
