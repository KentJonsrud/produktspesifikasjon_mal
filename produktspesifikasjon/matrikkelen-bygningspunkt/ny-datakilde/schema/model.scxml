          <sc:Value>MATRIKKELENHETID</sc:Value>
         </sc:values>
        </sc:TaggedValue>
       </sc:taggedValues>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>3</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>uuidBruksenhet</sc:name>
       <sc:id>C5_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Objektidentifikator realisert som UUID, forvaltet av matrikkelsystemet</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
