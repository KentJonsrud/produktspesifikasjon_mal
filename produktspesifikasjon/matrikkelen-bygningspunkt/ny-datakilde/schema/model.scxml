          <sc:DescriptorValue>Næringsgruppe for varehandel, reparasjon av motorvogner</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>24</sc:sequenceNumber>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>OpprinnelsesKode</sc:name>
     <sc:id>C11</sc:id>
