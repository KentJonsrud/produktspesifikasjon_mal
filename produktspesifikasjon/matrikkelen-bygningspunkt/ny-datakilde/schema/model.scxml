      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>angir hvordan bygget opprinnelig ble registrert.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:taggedValues>
      <sc:TaggedValue>
       <sc:name>codeList</sc:name>
       <sc:values>
        <sc:Value>http://skjema.geonorge.no/legg_inn_riktig_url</sc:Value>
       </sc:values>
      </sc:TaggedValue>
