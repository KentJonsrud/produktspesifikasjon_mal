     <sc:properties>
      <sc:Property>
       <sc:name>huslopenummer</sc:name>
       <sc:id>C6_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Løpenummer innen kretsnummer.
Er entydig nøkkel for kulturminne sammen med kommune og kretsnummer.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>HUSLØPENUMMER</sc:Value>
         </sc:values>
        </sc:TaggedValue>
       </sc:taggedValues>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>registreringskretsnummer</sc:name>
       <sc:id>C6_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Registreringskretsnummer er Riksantikvarens oppdeling av kommunen. Tilsvarer gamle kirkekretser. Må være større enn 0.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>REGISTRERINGSKRETSNUMMER</sc:Value>
         </sc:values>
        </sc:TaggedValue>
       </sc:taggedValues>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>sefrakKommune</sc:name>
       <sc:id>C6_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>nummerering av kommuner i henhold til Statistisk sentralbyrå sin offisielle liste</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>SEFRAKKOMMUNE</sc:Value>
