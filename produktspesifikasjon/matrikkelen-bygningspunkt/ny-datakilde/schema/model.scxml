       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Klinikk; legekontor/legesenter; klinikk, legekontor/-senter/-vakt.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
