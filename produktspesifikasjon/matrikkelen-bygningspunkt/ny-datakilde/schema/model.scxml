       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Univ./høgskole m/auditor.leses; universitets- og høgskolebygning med integrerte funksjoner, auditorium, lesesal mv.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
