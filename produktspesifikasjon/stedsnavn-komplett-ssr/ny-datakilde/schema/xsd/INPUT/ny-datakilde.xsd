  <simpleType name="SpråkprioriteringKodeType">
    <annotation>
      <documentation>Kodeliste som angir visningsrekkefølgen til stedsnavn på forskjellig språk.

&lt;b&gt;Det er de første fem verdiene i kodene (de norske språkene) som varierer mellom kodene&lt;/b&gt;, ellers er det lik (alfabetisk i forhold til ISO-kodeverdien) rekkefølge på språkene som ikke er aktuelle for behandling etter lov om stadnamn.</documentation>
    </annotation>
    <union memberTypes="nydatakilde:SpråkprioriteringKodeEnumerationType nydatakilde:SpråkprioriteringKodeOtherType"/>
  </simpleType>
