       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Viktigere enn de med lavere nummer under samme bokstav i Sortering1Kode.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>98</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>viktighet99</sc:name>
       <sc:id>C15_99</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Viktigtse navn av de med samme sorteringsbokstav, har høyest prioritet.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>99</sc:sequenceNumber>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>SpråkprioriteringKode</sc:name>
     <sc:id>C16</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>Kodeliste som angir visningsrekkefølgen til stedsnavn på forskjellig språk.

&lt;b&gt;Det er de første fem verdiene i kodene (de norske språkene) som varierer mellom kodene&lt;/b&gt;, ellers er det lik (alfabetisk i forhold til ISO-kodeverdien) rekkefølge på språkene som ikke er aktuelle for behandling etter lov om stadnamn.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:taggedValues>
      <sc:TaggedValue>
       <sc:name>codeList</sc:name>
       <sc:values>
        <sc:Value>http://skjema.geonorge.no/SOSI/produktspesifikasjon/Stedsnavn/5.0Utkast/2016-03-30/SpråkprioriteringKode</sc:Value>
       </sc:values>
      </sc:TaggedValue>
      <sc:TaggedValue>
       <sc:name>asDictionary</sc:name>
       <sc:values>
        <sc:Value>false</sc:Value>
       </sc:values>
      </sc:TaggedValue>
     </sc:taggedValues>
     <sc:properties>
      <sc:Property>
