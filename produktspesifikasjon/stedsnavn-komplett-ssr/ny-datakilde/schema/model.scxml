      </sc:Property>
      <sc:Property>
       <sc:name>kommunenummer</sc:name>
       <sc:id>C4_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Kommunenummer er nummer for å identifisere kommunerer og er et firesifret nummer (eks.: 0101) som er unikt for hver kommune i Norge</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>KOMMUNENUMMER</sc:Value>
         </sc:values>
