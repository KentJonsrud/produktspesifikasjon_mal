    </sc:Class>
    <sc:Class>
     <sc:name>Navneobjekthovedgruppe</sc:name>
     <sc:id>C12</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>Hovedgruppeinndelingen av navneobjekttyper.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:taggedValues>
      <sc:TaggedValue>
       <sc:name>codeList</sc:name>
       <sc:values>
        <sc:Value>http://skjema.geonorge.no/SOSI/produktspesifikasjon/Stedsnavn/5.0/Navneobjekthovedgruppe</sc:Value>
       </sc:values>
      </sc:TaggedValue>
      <sc:TaggedValue>
       <sc:name>asDictionary</sc:name>
       <sc:values>
        <sc:Value>true</sc:Value>
       </sc:values>
      </sc:TaggedValue>
     </sc:taggedValues>
     <sc:properties>
      <sc:Property>
       <sc:name>bebyggelse</sc:name>
       <sc:id>C12_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Alle grupper som er relevante under hovedgruppe bebyggelse. Tilsvarer Inspire temaet "building" og "populatedPlace".</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>ferskvann</sc:name>
       <sc:id>C12_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Alle grupper som er relevante under hovedgruppe Ferskvann. Under Inspire temaet "hydrography" som vi har delt i to.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>infrastruktur</sc:name>
       <sc:id>C12_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Alle grupper som er relevante under hovedgruppe infrastruktur. Tilsvarer Inspire temaet "transportNetwork".</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>kultur</sc:name>
       <sc:id>C12_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Alle grupper som er relevante under hovedgruppe Kultur.
Tilsvarer Inspire temaet "protctedSite".</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>4</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>markslag</sc:name>
       <sc:id>C12_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Alle grupper som er relevante under hovedgruppe Markslag. Tilsvarer Inspire temaet "landcover".</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>5</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>offentligAdministrasjon</sc:name>
       <sc:id>C12_6</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Alle grupper som er relevante under hovedgruppe offentlig administrasjon. Tilsvarer Inspire temaet "administrativUnit".</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>6</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>sjø</sc:name>
       <sc:id>C12_7</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Alle grupper som er relevante under hovedgruppe Sjø. Under Inspire temaet "hydrography" som vi har delt i to.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>7</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>terreng</sc:name>
       <sc:id>C12_8</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Alle  grupper som beskriver terrengformasjoner.
Tilsvarer Inspire temaet "landform".</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>8</sc:sequenceNumber>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>Navneobjekttype</sc:name>
     <sc:id>C13</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>Detaljert klassifisering av hvilke type fenomen stedsnavnet står til.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:taggedValues>
      <sc:TaggedValue>
       <sc:name>codeList</sc:name>
       <sc:values>
        <sc:Value>http://skjema.geonorge.no/SOSI/produktspesifikasjon/Stedsnavn/5.0/Navneobjekttype</sc:Value>
       </sc:values>
      </sc:TaggedValue>
      <sc:TaggedValue>
       <sc:name>asDictionary</sc:name>
       <sc:values>
        <sc:Value>true</sc:Value>
       </sc:values>
      </sc:TaggedValue>
     </sc:taggedValues>
     <sc:properties>
      <sc:Property>
       <sc:name>administrativBydel</sc:name>
       <sc:id>C13_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Offisielt navn på bydelsforvaltningen i et angitt område.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>adressenavn</sc:name>
       <sc:id>C13_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Offisielt adressenavn, veg-/gatenavn eller områdenavn, jf. § 2 bokstav e i matrikkelforskriften.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>adressetilleggsnavn</sc:name>
       <sc:id>C13_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Et stedsnavn som er en del av den offisielle (veg-)adressen, jf. § 54 i matrikkelforskriften; vanligvis bruksnavn eller sjeldnere bygnings-/institusjonsnavn.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>allmenning</sc:name>
       <sc:id>C13_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Område hvor rettighetene er regulert og fordelt på flere.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>4</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>alpinanlegg</sc:name>
       <sc:id>C13_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Anlegg for slalåm, utfor, snøbrett osv.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>5</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>ankringsplass</sc:name>
       <sc:id>C13_6</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Opplagsplass for store fartøy.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>6</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>annenAdministrativInndeling</sc:name>
       <sc:id>C13_7</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Andre administrative inndelinger som ikke tilhører øvrige navneobjekttyper.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>7</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>annenBygningForReligionsutøvelse</sc:name>
       <sc:id>C13_8</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Synagoge, moské, frikirke, menighetshus, kloster, gravkapell, bårehus, krematorium.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>8</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>annenIndustri-OgLagerbygning</sc:name>
       <sc:id>C13_9</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Mindre industri- og produksjonsbedrift eller lager.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>9</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>annenKulturdetalj</sc:name>
       <sc:id>C13_10</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Alle andre typer kulturdetaljer, f.eks. lekeplass, utkikkstårn, fiskeplass, og lignende.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>10</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>annenTerrengdetalj</sc:name>
       <sc:id>C13_11</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Små detaljer som ikke dekkes av andre navneobjekttyper innenfor kategorien.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>11</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>annenVanndetalj</sc:name>
       <sc:id>C13_12</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Andre navngitte forhold i ferskvann.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>12</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>badeplass</sc:name>
       <sc:id>C13_13</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Offentlig eller privat badeplass.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>13</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>bakke</sc:name>
       <sc:id>C13_14</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Terrengskråning, særlig om siden av en ås eller haug.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>14</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>bakkeISjø</sc:name>
       <sc:id>C13_15</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Skrånende sjøbunn.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>15</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>bakketoppISjø</sc:name>
       <sc:id>C13_16</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Undersjøisk knaus, kolle eller haug.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>16</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>bakkeVeg</sc:name>
       <sc:id>C13_17</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Allment kjent bakke på alle typer veger og gater.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>17</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>banestrekning</sc:name>
       <sc:id>C13_18</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Jernbanestrekning, tunnelbane eller trikkelinje/-strekning.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>18</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>banke</sc:name>
       <sc:id>C13_19</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Flatt, større undervannsområde.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>19</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>bankeISjø</sc:name>
       <sc:id>C13_20</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Større grunt område i sjøen med dypere vann omkring; fiskegrunn.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>20</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>barnehage</sc:name>
       <sc:id>C13_21</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Offentlig og privat barnehage.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>21</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>bassengISjø</sc:name>
       <sc:id>C13_22</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Vid, undersjøisk dal.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>22</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>bekk</sc:name>
       <sc:id>C13_23</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Rennende vann i naturlig vannvei, vanligvis smalere enn 3 meter.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>23</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>berg</sc:name>
       <sc:id>C13_24</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Markert eller avrunda høyde med stein, steinmasse (med eller uten vegetasjon).</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>24</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>bergverk</sc:name>
       <sc:id>C13_25</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Gruve, skjerp og mineraluttak i dagen eller under jorda.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>25</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>boinstitusjon</sc:name>
       <sc:id>C13_26</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dekker både tilrettelagte boliger og asyl-/flykningmottak.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>26</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>boligblokk</sc:name>
       <sc:id>C13_27</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Stort (bolig)hus av mur, betong med over fire boliger som har felles trapp(er) eller heis(er).</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>27</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>boligfelt</sc:name>
       <sc:id>C13_28</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Regulert boligområde.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>28</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>bomstasjon</sc:name>
       <sc:id>C13_29</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Større bomanlegg på offentlig veg.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>29</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>borettslag</sc:name>
       <sc:id>C13_30</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Bofellesskap i blokk eller flerbebyggelse.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>30</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>botn</sc:name>
       <sc:id>C13_31</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Innerste del av en dal; rundaktig, bratt dal eller uthulning i fjellet.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>31</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>bru</sc:name>
       <sc:id>C13_32</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Både på veg og jernbane.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>32</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>bruk</sc:name>
       <sc:id>C13_33</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Navn på (landbruks)eiendom med ett eller flere bruksnummer under ett gardsnummer, jf. lov om stadnamn §§ 2 og 8.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>33</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>brygge</sc:name>
       <sc:id>C13_34</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Mindre, fastbygd bryggeanlegg.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>34</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>busstasjon</sc:name>
       <sc:id>C13_35</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Større busstopp der flere busslinjer kobles, knutepunkt.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>35</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>busstopp</sc:name>
       <sc:id>C13_36</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Stoppested for rutegående vegtrafikk.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>36</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>by</sc:name>
       <sc:id>C13_37</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Tettbygd sted som er større og (til dels) innehar viktigere funksjoner enn andre tettbygde steder / tettsteder.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>37</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>bydel</sc:name>
       <sc:id>C13_38</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Kulturmessig del av by.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>38</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>bygdelagBygd</sc:name>
       <sc:id>C13_39</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Stort, uregulert gards- og boligområde.</sc:DescriptorValue>
         </sc:descriptorValues>
