     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>Beskriver hva slags tilleggsopplysning dette er.</sc:DescriptorValue>
       </sc:descriptorValues>
