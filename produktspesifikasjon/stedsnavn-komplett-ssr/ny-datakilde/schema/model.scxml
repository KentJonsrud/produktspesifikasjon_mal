       <sc:id>C5_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Bokstavkode fra A til N der N er viktigste objekttype som tegnes først, mens A er de minst viktige som vises dersom det er plass.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>sortering1Kode</sc:Value>
         </sc:values>
        </sc:TaggedValue>
       </sc:taggedValues>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeId>C14</sc:typeId>
       <sc:typeName>Sortering1Kode</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>sortering2Kode</sc:name>
       <sc:id>C5_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Tall fra 1 til 99 som brukes til å sortere innefor sortering1kode, der 99 har høyest prioritet.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
