       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeId>C8</sc:typeId>
       <sc:typeName>Fylkesnummer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>kommunenavn</sc:name>
       <sc:id>C4_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Navnet på kommunen, navnet vises på flere språk dersom kommunen er flerspråklig.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>kommunenavn</sc:Value>
